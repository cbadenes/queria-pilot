gmail.com","filename":"guia_calidad_de_datos_abiertos_Tema1.pdf","id":"3514369e2205c8d70d867b6772fa9eb1","name":"daab","num_questions":3,"ratio":0,"status":"in_progress"},{"date":"Thu, 13 Mar 2025 18:40:55 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"a507c3dd0af021164b246b442162da3f","name":"ocr1","num_questions":3,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:13:39 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"f7c7d0c0b42d3f0a0846379c2cda3835","name":"Vector2","num_questions":4,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:16:41 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"5b5493cff53c4de28d3f4b22d24eec56","name":"Vector3","num_questions":3,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:24:07 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"cc0d7f22d82ea8a3f85b220687f945ae","name":"Vector4","num_questions":4,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:26:51 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"faebc7728793c26d3cfd86b5eaa058d9","name":"Vector5","num_questions":5,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:28:58 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"5ea3f37aa710aabf32ae715a6c5f660d","name":"Vector6","num_questions":4,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:33:16 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"439475f37f561a27f58e82ea6e4cbc9e","name":"Vector7","num_questions":3,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:42:31 GMT","difficulty":"Medio","email":"cbadenes@gmail.com","filename":"tema3.pdf","id":"6ba7d0302c4237207085d6df160667f8","name":"Vector8","num_questions":3,"ratio":0,"status":"scheduled"},{"date":"Fri, 14 Mar 2025 09:45:59 GMT","difficulty":"Medio","email":"cb